# 서버 전용 환경변수 — 절대 프론트엔드(chatbot.js, index.html)에 넣거나 커밋하지 마세요.
# Vercel: Project Settings → Environment Variables 에 동일하게 등록해야 /api/chat, /api/lead가 동작합니다.
# 로컬(인제스트 스크립트 실행용): 이 파일을 .env로 복사한 뒤 값을 채워주세요.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
OPENAI_API_KEY=sk-...

# 선택: 답변 생성 모델 (기본값 gpt-4o-mini)
LL_CHAT_MODEL=gpt-4o-mini
